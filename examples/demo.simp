import math as math

struct Point { x: float, y: float }

fn add(a: float, b: float) -> float {
  return a + b;
}

fn main(x: float, flag: bool) -> float {
  let p: Point = Point { x: x, y: 1.0 };
  let t: pyobj = math.tanh(x);
  let m: float = unbox<float>(t);
  // Native dictionary: intro form + subscript load/store.
  let d: dict<str, float> = dict<str, float> { "a": x, "b": 1.0 };
  d["a"] = m;
  // Runtime-checked unboxing into a struct (in addition to primitives).
  // let q: Point = unbox<Point>(t);
  let z: float = flag ? add(d["a"], p.x) : (x * 2.0 - p.y);
  return z;
}
